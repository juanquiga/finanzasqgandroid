<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#060F1A">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@drawable/finanzas_card_background" android:padding="20dp"
        android:layout_marginStart="14dp" android:layout_marginEnd="14dp"
        android:layout_marginTop="14dp" android:layout_marginBottom="4dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="⚙️  Configuración" android:textColor="#4CAF50"
            android:textSize="18sp" android:textStyle="bold"/>
    </LinearLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent"
        android:overScrollMode="never">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingBottom="28dp">

            <!-- Avatar -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/finanzas_card_background"
                android:padding="22dp" android:gravity="center"
                android:layout_marginTop="12dp" android:layout_marginBottom="12dp">
                <TextView android:layout_width="72dp" android:layout_height="72dp"
                    android:gravity="center" android:text="💰" android:textSize="36sp"
                    android:background="@drawable/finanzas_badge_ingreso"/>
                <TextView android:id="@+id/tvNombreCuenta"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Usuario" android:textColor="#EEFFEE"
                    android:textSize="20sp" android:textStyle="bold"
                    android:layout_marginTop="14dp"/>
                <TextView android:id="@+id/tvEmailCuenta"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="usuario@email.com" android:textColor="#334455"
                    android:textSize="13sp" android:layout_marginTop="4dp"/>
            </LinearLayout>

            <!-- Stats -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/finanzas_card_background"
                android:padding="16dp" android:layout_marginBottom="12dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical"
                    android:gravity="center">
                    <TextView android:id="@+id/tvTotalMovimientos"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="0" android:textColor="#4CAF50"
                        android:textSize="30sp" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Movimientos" android:textColor="#334455"
                        android:textSize="12sp"/>
                </LinearLayout>
                <View android:layout_width="1dp" android:layout_height="match_parent"
                    android:background="#1A3A4A"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical"
                    android:gravity="center">
                    <TextView android:id="@+id/tvMesActivo"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="2026" android:textColor="#69F0AE"
                        android:textSize="30sp" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Año activo" android:textColor="#334455"
                        android:textSize="12sp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Opciones -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/finanzas_card_background"
                android:paddingTop="4dp" android:paddingBottom="4dp"
                android:layout_marginBottom="12dp">

                <!-- Cambiar nombre -->
                <LinearLayout android:id="@+id/filaCambiarNombre"
                    android:layout_width="match_parent" android:layout_height="58dp"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingStart="16dp" android:paddingEnd="16dp"
                    android:clickable="true" android:focusable="true"
                    android:background="?android:attr/selectableItemBackground">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="👤" android:textSize="18sp" android:layout_marginEnd="14dp"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Cambiar nombre"
                        android:textColor="#EEFFEE" android:textSize="15sp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="›" android:textColor="#334455" android:textSize="24sp"/>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="#0D2A3A" android:layout_marginStart="48dp"/>

                <!-- Cambiar contraseña -->
                <LinearLayout android:id="@+id/filaCambiarContrasena"
                    android:layout_width="match_parent" android:layout_height="58dp"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingStart="16dp" android:paddingEnd="16dp"
                    android:clickable="true" android:focusable="true"
                    android:background="?android:attr/selectableItemBackground">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="🔒" android:textSize="18sp" android:layout_marginEnd="14dp"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Cambiar contraseña"
                        android:textColor="#EEFFEE" android:textSize="15sp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="›" android:textColor="#334455" android:textSize="24sp"/>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="#0D2A3A" android:layout_marginStart="48dp"/>

                <!-- Modificar categorías -->
                <LinearLayout android:id="@+id/filaModificarRegistros"
                    android:layout_width="match_parent" android:layout_height="58dp"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingStart="16dp" android:paddingEnd="16dp"
                    android:clickable="true" android:focusable="true"
                    android:background="?android:attr/selectableItemBackground">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="✏️" android:textSize="18sp" android:layout_marginEnd="14dp"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Modificar categorías"
                        android:textColor="#EEFFEE" android:textSize="15sp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="›" android:textColor="#334455" android:textSize="24sp"/>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="#0D2A3A" android:layout_marginStart="48dp"/>

                <!-- Presupuesto — separado -->
                <LinearLayout android:id="@+id/filaPresupuesto"
                    android:layout_width="match_parent" android:layout_height="58dp"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingStart="16dp" android:paddingEnd="16dp"
                    android:clickable="true" android:focusable="true"
                    android:background="?android:attr/selectableItemBackground">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="💳" android:textSize="18sp" android:layout_marginEnd="14dp"/>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Presupuesto" android:textColor="#EEFFEE"
                            android:textSize="15sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Configura límites de gasto"
                            android:textColor="#334455" android:textSize="12sp"/>
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="›" android:textColor="#334455" android:textSize="24sp"/>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="#0D2A3A" android:layout_marginStart="48dp"/>

                <!-- Contacto -->
                <LinearLayout android:id="@+id/filaContacto"
                    android:layout_width="match_parent" android:layout_height="58dp"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingStart="16dp" android:paddingEnd="16dp"
                    android:clickable="true" android:focusable="true"
                    android:background="?android:attr/selectableItemBackground">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="💬" android:textSize="18sp" android:layout_marginEnd="14dp"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Contáctanos"
                        android:textColor="#EEFFEE" android:textSize="15sp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="›" android:textColor="#334455" android:textSize="24sp"/>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="#0D2A3A" android:layout_marginStart="48dp"/>

                <!-- Términos -->
                <LinearLayout android:id="@+id/filaTerminos"
                    android:layout_width="match_parent" android:layout_height="58dp"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingStart="16dp" android:paddingEnd="16dp"
                    android:clickable="true" android:focusable="true"
                    android:background="?android:attr/selectableItemBackground">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="📄" android:textSize="18sp" android:layout_marginEnd="14dp"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Términos y condiciones"
                        android:textColor="#EEFFEE" android:textSize="15sp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="›" android:textColor="#334455" android:textSize="24sp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Cerrar sesión -->
            <Button android:id="@+id/btnCerrarSesionFinanzas"
                android:layout_width="match_parent" android:layout_height="54dp"
                android:text="CERRAR SESIÓN" android:textAllCaps="false"
                android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold"
                android:backgroundTint="#8B0000" android:layout_marginTop="8dp"/>

        </LinearLayout>
    </ScrollView>
</LinearLayout>