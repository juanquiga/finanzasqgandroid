<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingTop="20dp"
        android:paddingBottom="16dp">

        <!-- Emoji grande en círculo -->
        <FrameLayout
            android:layout_width="130dp"
            android:layout_height="130dp"
            android:layout_gravity="center"
            android:layout_marginBottom="24dp">

            <View
                android:layout_width="130dp"
                android:layout_height="130dp"
                android:background="@drawable/finanzas_badge_ingreso"/>

            <TextView
                android:id="@+id/tvOnboardingEmoji"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="💰"
                android:textSize="56sp"/>
        </FrameLayout>

        <!-- Título -->
        <TextView
            android:id="@+id/tvOnboardingTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Título"
            android:textColor="#4CAF50"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="8dp"/>

        <!-- Subtítulo -->
        <TextView
            android:id="@+id/tvOnboardingSubtitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Subtítulo"
            android:textColor="#334455"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginBottom="18dp"/>

        <!-- Descripción -->
        <TextView
            android:id="@+id/tvOnboardingDescripcion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Descripción"
            android:textColor="#AABBCC"
            android:textSize="14sp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="20dp"/>

        <!-- Bullets -->
        <LinearLayout
            android:id="@+id/cardBullets"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:id="@+id/containerBullets"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>