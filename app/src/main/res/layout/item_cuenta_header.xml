<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="#0D2A3A"
    android:paddingStart="8dp" android:paddingEnd="8dp"
    android:paddingTop="10dp" android:paddingBottom="10dp">

    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="2" android:text="Cuenta"
        android:textColor="#4CAF50" android:textSize="11sp" android:textStyle="bold"/>

    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="2" android:text="Ingresos"
        android:textColor="#69F0AE" android:textSize="11sp" android:textStyle="bold"
        android:gravity="end"/>

    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="2" android:text="Egresos"
        android:textColor="#FF5252" android:textSize="11sp" android:textStyle="bold"
        android:gravity="end"/>

    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="2" android:text="Enviadas"
        android:textColor="#2196F3" android:textSize="11sp" android:textStyle="bold"
        android:gravity="end"/>

    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="2" android:text="Recibidas"
        android:textColor="#00BCD4" android:textSize="11sp" android:textStyle="bold"
        android:gravity="end"/>

</LinearLayout>