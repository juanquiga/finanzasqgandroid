<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0A1628"
    android:gravity="center">

    <!-- Skip arriba -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:padding="16dp">

        <Button
            android:id="@+id/btnOnboardingSaltar"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Saltar"
            android:textColor="#445566"
            android:textSize="13sp"
            android:backgroundTint="#0D1A2A" />

    </LinearLayout>

    <!-- Contenido central -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="32dp"
        android:paddingEnd="32dp">

        <!-- Emoji -->
        <TextView
            android:id="@+id/tvOnboardingEmoji"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💰"
            android:textSize="80sp"
            android:layout_marginBottom="24dp" />

        <!-- Título -->
        <TextView
            android:id="@+id/tvOnboardingTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bienvenido a FinanzasQG"
            android:textColor="#4CAF50"
            android:textSize="26sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="20dp" />

        <!-- Línea decorativa -->
        <View
            android:layout_width="60dp"
            android:layout_height="3dp"
            android:background="#4CAF50"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="20dp" />

        <!-- Texto descriptivo -->
        <TextView
            android:id="@+id/tvOnboardingTexto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Descripción"
            android:textColor="#9999BB"
            android:textSize="15sp"
            android:gravity="center"
            android:lineSpacingExtra="6dp" />

    </LinearLayout>

    <!-- Parte inferior -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="40dp">

        <!-- Indicador de página -->
        <TextView
            android:id="@+id/tvOnboardingPagina"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1 / 5"
            android:textColor="#445566"
            android:textSize="13sp"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <!-- Botón siguiente -->
        <Button
            android:id="@+id/btnOnboardingSiguiente"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Siguiente →"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/finanzas_btn_green" />

    </LinearLayout>

</LinearLayout>