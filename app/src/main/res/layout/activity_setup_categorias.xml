<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0A1628">

    <!-- Header -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@drawable/finanzas_card_background"
        android:orientation="vertical" android:gravity="center"
        android:padding="16dp"
        android:layout_marginStart="16dp" android:layout_marginEnd="16dp"
        android:layout_marginTop="16dp" android:layout_marginBottom="10dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="🎯 Personalización"
            android:textColor="#4CAF50" android:textSize="20sp" android:textStyle="bold"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Categorías · Cuentas · Presupuesto"
            android:textColor="#445566" android:textSize="12sp"
            android:layout_marginTop="4dp"/>
    </LinearLayout>

    <!-- Selector — 2x2 grid para que quepan bien -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp" android:paddingEnd="16dp"
        android:layout_marginBottom="8dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="4dp">
            <Button android:id="@+id/btnSeccionEgresos"
                android:layout_width="0dp" android:layout_height="40dp"
                android:layout_weight="1" android:text="📉 Egresos"
                android:textSize="12sp" android:textAllCaps="false"
                android:textColor="#050510" android:backgroundTint="#4CAF50"
                android:layout_marginEnd="4dp"/>
            <Button android:id="@+id/btnSeccionIngresos"
                android:layout_width="0dp" android:layout_height="40dp"
                android:layout_weight="1" android:text="📈 Ingresos"
                android:textSize="12sp" android:textAllCaps="false"
                android:textColor="#4CAF50" android:backgroundTint="#0D1A2A"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button android:id="@+id/btnSeccionCuentas"
                android:layout_width="0dp" android:layout_height="40dp"
                android:layout_weight="1" android:text="🏦 Cuentas"
                android:textSize="12sp" android:textAllCaps="false"
                android:textColor="#4CAF50" android:backgroundTint="#0D1A2A"
                android:layout_marginEnd="4dp"/>
            <Button android:id="@+id/btnSeccionPresupuesto"
                android:layout_width="0dp" android:layout_height="40dp"
                android:layout_weight="1" android:text="💳 Máximos"
                android:textSize="12sp" android:textAllCaps="false"
                android:textColor="#4CAF50" android:backgroundTint="#0D1A2A"/>
        </LinearLayout>

    </LinearLayout>

    <!-- Contenido scrollable -->
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout android:id="@+id/containerSetup"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp" android:paddingEnd="16dp"
            android:paddingBottom="16dp" android:paddingTop="4dp"/>
    </ScrollView>

    <!-- Botón guardar -->
    <Button android:id="@+id/btnGuardarSetup"
        android:layout_width="match_parent" android:layout_height="54dp"
        android:text="GUARDAR Y CONTINUAR"
        android:textAllCaps="false"
        android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold"
        android:background="@drawable/finanzas_btn_green"
        android:layout_marginStart="16dp" android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp" android:layout_marginTop="8dp"/>

</LinearLayout>