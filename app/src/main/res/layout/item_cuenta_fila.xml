<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingStart="8dp" android:paddingEnd="8dp"
    android:paddingTop="10dp" android:paddingBottom="10dp">

    <TextView android:id="@+id/tvCuentaNombre"
        android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="2" android:text="Cuenta"
        android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold"
        android:ellipsize="end" android:maxLines="1"/>

    <TextView android:id="@+id/tvCuentaIngresos"
        android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="2" android:text="$0"
        android:textColor="#69F0AE" android:textSize="10sp"
        android:gravity="end" android:ellipsize="end" android:maxLines="1"/>

    <TextView android:id="@+id/tvCuentaEgresos"
        android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="2" android:text="$0"
        android:textColor="#FF5252" android:textSize="10sp"
        android:gravity="end" android:ellipsize="end" android:maxLines="1"/>

    <TextView android:id="@+id/tvCuentaEnviadas"
        android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="2" android:text="$0"
        android:textColor="#2196F3" android:textSize="10sp"
        android:gravity="end" android:ellipsize="end" android:maxLines="1"/>

    <TextView android:id="@+id/tvCuentaRecibidas"
        android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="2" android:text="$0"
        android:textColor="#00BCD4" android:textSize="10sp"
        android:gravity="end" android:ellipsize="end" android:maxLines="1"/>

</LinearLayout>