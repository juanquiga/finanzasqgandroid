<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0A1628">

    <!-- Header -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@drawable/finanzas_card_background" android:padding="16dp"
        android:layout_marginStart="16dp" android:layout_marginEnd="16dp"
        android:layout_marginTop="16dp" android:layout_marginBottom="6dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="📊 Gráficas y Análisis"
            android:textColor="#4CAF50" android:textSize="18sp" android:textStyle="bold"/>
    </LinearLayout>

    <!-- Período -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp" android:paddingEnd="16dp"
        android:layout_marginBottom="6dp">
        <Button android:id="@+id/btnGrafMensual"
            android:layout_width="0dp" android:layout_height="38dp" android:layout_weight="1"
            android:text="Mensual" android:textSize="13sp" android:textAllCaps="false"
            android:textColor="#050510" android:backgroundTint="#4CAF50"
            android:layout_marginEnd="6dp"/>
        <Button android:id="@+id/btnGrafAnual"
            android:layout_width="0dp" android:layout_height="38dp" android:layout_weight="1"
            android:text="Anual" android:textSize="13sp" android:textAllCaps="false"
            android:textColor="#4CAF50" android:backgroundTint="#0D1A2A"/>
    </LinearLayout>

    <!-- Filtro tipo -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp" android:paddingEnd="16dp"
        android:layout_marginBottom="6dp">
        <Button android:id="@+id/btnGrafTodo"
            android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1"
            android:text="Todo" android:textSize="12sp" android:textAllCaps="false"
            android:textColor="#050510" android:backgroundTint="#4CAF50"
            android:layout_marginEnd="4dp"/>
        <Button android:id="@+id/btnGrafIngreso"
            android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1"
            android:text="Ingresos" android:textSize="12sp" android:textAllCaps="false"
            android:textColor="#4CAF50" android:backgroundTint="#0D1A2A"
            android:layout_marginEnd="4dp"/>
        <Button android:id="@+id/btnGrafEgreso"
            android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1"
            android:text="Egresos" android:textSize="12sp" android:textAllCaps="false"
            android:textColor="#4CAF50" android:backgroundTint="#0D1A2A"/>
    </LinearLayout>

    <!-- Filtro moneda -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp" android:paddingEnd="16dp"
        android:layout_marginBottom="8dp">
        <Button android:id="@+id/btnGrafMonedaTodas"
            android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1"
            android:text="🌐 Ambas" android:textSize="11sp" android:textAllCaps="false"
            android:textColor="#050510" android:backgroundTint="#4CAF50"
            android:layout_marginEnd="4dp"/>
        <Button android:id="@+id/btnGrafMonedaCOP"
            android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1"
            android:text="🇨🇴 COP" android:textSize="11sp" android:textAllCaps="false"
            android:textColor="#4CAF50" android:backgroundTint="#0D1A2A"
            android:layout_marginEnd="4dp"/>
        <Button android:id="@+id/btnGrafMonedaUSD"
            android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1"
            android:text="🇺🇸 USD" android:textSize="11sp" android:textAllCaps="false"
            android:textColor="#4CAF50" android:backgroundTint="#0D1A2A"/>
    </LinearLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp" android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <!-- Barras -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/finanzas_card_background"
                android:padding="16dp" android:layout_marginBottom="12dp">
                <TextView android:id="@+id/tvTituloBarras"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Por Categoría"
                    android:textColor="#AABBCC" android:textSize="14sp"
                    android:textStyle="bold" android:layout_marginBottom="12dp"/>
                <com.jdqg.finanzasqg.GraficaBarrasView
                    android:id="@+id/graficaBarras"
                    android:layout_width="match_parent" android:layout_height="220dp"/>
            </LinearLayout>

            <!-- Donut + leyenda -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/finanzas_card_background"
                android:padding="16dp" android:layout_marginBottom="12dp">

                <TextView android:id="@+id/tvTituloDonut"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Ingresos vs Egresos"
                    android:textColor="#AABBCC" android:textSize="14sp"
                    android:textStyle="bold" android:layout_marginBottom="12dp"/>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Donut -->
                    <com.jdqg.finanzasqg.GraficaDonutView
                        android:id="@+id/graficaDonut"
                        android:layout_width="0dp" android:layout_height="180dp"
                        android:layout_weight="1"/>

                    <!-- Leyenda -->
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical"
                        android:gravity="center_vertical" android:paddingStart="12dp">

                        <!-- Ingresos -->
                        <LinearLayout android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="10dp">
                            <View android:layout_width="12dp" android:layout_height="12dp"
                                android:background="#4CAF50" android:layout_marginEnd="8dp"/>
                            <LinearLayout android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">
                                <TextView android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Ingresos"
                                    android:textColor="#445566" android:textSize="11sp"/>
                                <TextView android:id="@+id/tvLeyendaIngresos"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="$0"
                                    android:textColor="#4CAF50"
                                    android:textSize="13sp" android:textStyle="bold"/>
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Egresos -->
                        <LinearLayout android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="10dp">
                            <View android:layout_width="12dp" android:layout_height="12dp"
                                android:background="#FF5252" android:layout_marginEnd="8dp"/>
                            <LinearLayout android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">
                                <TextView android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Egresos"
                                    android:textColor="#445566" android:textSize="11sp"/>
                                <TextView android:id="@+id/tvLeyendaEgresos"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="$0"
                                    android:textColor="#FF5252"
                                    android:textSize="13sp" android:textStyle="bold"/>
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Balance -->
                        <View android:layout_width="match_parent" android:layout_height="1dp"
                            android:background="#1E3A4A" android:layout_marginBottom="10dp"/>
                        <LinearLayout android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <View android:layout_width="12dp" android:layout_height="12dp"
                                android:background="#4CAF50" android:layout_marginEnd="8dp"/>
                            <LinearLayout android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">
                                <TextView android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Balance"
                                    android:textColor="#445566" android:textSize="11sp"/>
                                <TextView android:id="@+id/tvLeyendaBalance"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="$0"
                                    android:textColor="#4CAF50"
                                    android:textSize="13sp" android:textStyle="bold"/>
                            </LinearLayout>
                        </LinearLayout>

                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Proyección general -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/finanzas_card_background"
                android:padding="16dp" android:layout_marginBottom="12dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="💳 Control de Gastos del Mes"
                    android:textColor="#AABBCC" android:textSize="14sp"
                    android:textStyle="bold" android:layout_marginBottom="10dp"/>
                <TextView android:id="@+id/tvPresupuestoActual"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Sin presupuesto configurado"
                    android:textColor="#445566" android:textSize="12sp"
                    android:layout_marginBottom="6dp"/>
                <TextView android:id="@+id/tvGastoTotalMes"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Gastado: $0"
                    android:textColor="#FF9800" android:textSize="16sp"
                    android:textStyle="bold" android:layout_marginBottom="10dp"/>
                <ProgressBar
                    android:id="@+id/barraProyeccion"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent" android:layout_height="20dp"
                    android:max="100" android:progress="0"
                    android:progressTint="#4CAF50"
                    android:progressBackgroundTint="#1E3A4A"
                    android:layout_marginBottom="8dp"/>
                <TextView android:id="@+id/tvPorcentajeGasto"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="0% del presupuesto"
                    android:textColor="#4CAF50" android:textSize="13sp"
                    android:gravity="end"/>
            </LinearLayout>

            <!-- Control por categoría -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/finanzas_card_background"
                android:padding="16dp" android:layout_marginBottom="12dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="🎯 Control por Categoría"
                    android:textColor="#AABBCC" android:textSize="14sp"
                    android:textStyle="bold" android:layout_marginBottom="4dp"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Gastos vs máximo configurado este mes"
                    android:textColor="#445566" android:textSize="11sp"
                    android:layout_marginBottom="10dp"/>
                <LinearLayout android:id="@+id/tablaMaximosCategorias"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical"/>
            </LinearLayout>

            <!-- Top categorías -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/finanzas_card_background"
                android:padding="16dp" android:layout_marginBottom="12dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="🏆 Top Categorías"
                    android:textColor="#AABBCC" android:textSize="14sp"
                    android:textStyle="bold" android:layout_marginBottom="12dp"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerTopCategorias"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"/>
            </LinearLayout>

            <!-- Registro por cuenta -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/finanzas_card_background"
                android:padding="16dp" android:layout_marginBottom="12dp">
                <LinearLayout android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🏦 Registro de cuentas"
                        android:textColor="#AABBCC" android:textSize="14sp"
                        android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Por actividad"
                        android:textColor="#445566" android:textSize="11sp"/>
                </LinearLayout>
                <LinearLayout android:id="@+id/tablaCuentas"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical"/>
            </LinearLayout>

            <!-- Botón historial -->
            <Button android:id="@+id/btnVerHistorial"
                android:layout_width="match_parent" android:layout_height="56dp"
                android:text="📋  VER HISTORIAL COMPLETO  →"
                android:textAllCaps="false"
                android:textColor="#FFFFFF" android:textSize="15sp"
                android:textStyle="bold"
                android:background="@drawable/finanzas_btn_green"
                android:layout_marginBottom="4dp"/>

            <TextView android:id="@+id/tvTotalHistorial"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="0 registros"
                android:textColor="#445566" android:textSize="12sp"
                android:gravity="center"/>

        </LinearLayout>
    </ScrollView>
</LinearLayout>