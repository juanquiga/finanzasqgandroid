<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#060F1A">

    <!-- Header con gradiente -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@drawable/finanzas_card_background"
        android:padding="18dp" android:gravity="center"
        android:layout_marginStart="14dp" android:layout_marginEnd="14dp"
        android:layout_marginTop="14dp" android:layout_marginBottom="10dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="💰 Registrar Movimiento"
            android:textColor="#4CAF50" android:textSize="19sp"
            android:textStyle="bold" android:gravity="center"
            android:letterSpacing="0.02"/>
    </LinearLayout>

    <!-- Selector tipo — más elegante -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/finanzas_card_background"
        android:paddingStart="6dp" android:paddingEnd="6dp"
        android:paddingTop="8dp" android:paddingBottom="8dp"
        android:layout_marginStart="14dp" android:layout_marginEnd="14dp"
        android:layout_marginBottom="10dp">
        <Button android:id="@+id/btnTipoEgreso"
            android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1"
            android:text="📉 Egreso" android:textSize="13sp" android:textAllCaps="false"
            android:textColor="#FFFFFF" android:textStyle="bold"
            android:backgroundTint="#FF5252" android:layout_marginEnd="4dp"/>
        <Button android:id="@+id/btnTipoIngreso"
            android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1"
            android:text="📈 Ingreso" android:textSize="13sp" android:textAllCaps="false"
            android:textColor="#4CAF50" android:backgroundTint="#0D1A2A" android:layout_marginEnd="4dp"/>
        <Button android:id="@+id/btnTipoTransferencia"
            android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1"
            android:text="🔄 Transfer" android:textSize="11sp" android:textAllCaps="false"
            android:textColor="#2196F3" android:backgroundTint="#0D1A2A"/>
    </LinearLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingBottom="28dp">

            <!-- FECHA — selector de calendario -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/finanzas_card_background"
                android:padding="14dp" android:gravity="center_vertical"
                android:layout_marginBottom="10dp">
                <TextView android:id="@+id/tvFechaSeleccionada"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="📅 Hoy" android:textColor="#AABBCC"
                    android:textSize="14sp"/>
                <Button android:id="@+id/btnFecha"
                    android:layout_width="wrap_content" android:layout_height="36dp"
                    android:text="Cambiar" android:textSize="12sp" android:textAllCaps="false"
                    android:textColor="#4CAF50" android:backgroundTint="#0D2A1A"
                    android:paddingStart="14dp" android:paddingEnd="14dp"/>
            </LinearLayout>

            <!-- Formulario normal -->
            <LinearLayout android:id="@+id/layoutFormularioNormal"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/finanzas_card_background"
                android:padding="16dp" android:layout_marginBottom="10dp">

                <!-- CATEGORÍA -->
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="CATEGORÍA" android:textColor="#4CAF50"
                    android:textSize="10sp" android:letterSpacing="0.15"
                    android:layout_marginBottom="6dp"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="52dp"
                    android:background="@drawable/finanzas_input_bg"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingStart="14dp" android:paddingEnd="14dp" android:layout_marginBottom="14dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="🏷" android:textSize="16sp" android:layout_marginEnd="10dp"/>
                    <Spinner android:id="@+id/spinnerCategoria"
                        android:layout_width="match_parent" android:layout_height="match_parent"
                        android:background="@null" android:popupBackground="#111E2E"/>
                </LinearLayout>

                <!-- SUBCATEGORÍA -->
                <TextView android:id="@+id/tvLabelSubcat"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="SUBCATEGORÍA" android:textColor="#4CAF50"
                    android:textSize="10sp" android:letterSpacing="0.15"
                    android:layout_marginBottom="6dp" android:visibility="gone"/>
                <LinearLayout android:id="@+id/layoutSubcat"
                    android:layout_width="match_parent" android:layout_height="52dp"
                    android:background="@drawable/finanzas_input_bg"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingStart="14dp" android:paddingEnd="14dp"
                    android:layout_marginBottom="14dp" android:visibility="gone">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="📂" android:textSize="16sp" android:layout_marginEnd="10dp"/>
                    <Spinner android:id="@+id/spinnerSubcategoria"
                        android:layout_width="match_parent" android:layout_height="match_parent"
                        android:background="@null" android:popupBackground="#111E2E"/>
                </LinearLayout>

                <!-- SUB-SUB CATEGORÍA -->
                <TextView android:id="@+id/tvLabelSubSubcat"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="DETALLE CATEGORÍA" android:textColor="#4CAF50"
                    android:textSize="10sp" android:letterSpacing="0.15"
                    android:layout_marginBottom="6dp" android:visibility="gone"/>
                <LinearLayout android:id="@+id/layoutSubSubcat"
                    android:layout_width="match_parent" android:layout_height="52dp"
                    android:background="@drawable/finanzas_input_bg"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingStart="14dp" android:paddingEnd="14dp"
                    android:layout_marginBottom="14dp" android:visibility="gone">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="📌" android:textSize="16sp" android:layout_marginEnd="10dp"/>
                    <Spinner android:id="@+id/spinnerSubSubcategoria"
                        android:layout_width="match_parent" android:layout_height="match_parent"
                        android:background="@null" android:popupBackground="#111E2E"/>
                </LinearLayout>

                <!-- DETALLE -->
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="DETALLE (opcional)" android:textColor="#4CAF50"
                    android:textSize="10sp" android:letterSpacing="0.15" android:layout_marginBottom="6dp"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="52dp"
                    android:background="@drawable/finanzas_input_bg"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingStart="14dp" android:paddingEnd="14dp" android:layout_marginBottom="14dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="📝" android:textSize="16sp" android:layout_marginEnd="10dp"/>
                    <EditText android:id="@+id/etDetalle"
                        android:layout_width="match_parent" android:layout_height="match_parent"
                        android:background="@null" android:hint="Descripción opcional..."
                        android:textColorHint="#334455" android:textSize="15sp" android:textColor="#EEFFEE"/>
                </LinearLayout>

                <!-- VALOR -->
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="VALOR" android:textColor="#4CAF50"
                    android:textSize="10sp" android:letterSpacing="0.15" android:layout_marginBottom="6dp"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="54dp"
                    android:background="@drawable/finanzas_input_bg"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingStart="14dp" android:paddingEnd="14dp" android:layout_marginBottom="6dp">
                    <Spinner android:id="@+id/spinnerMoneda"
                        android:layout_width="wrap_content" android:layout_height="match_parent"
                        android:background="@null" android:popupBackground="#111E2E"/>
                    <View android:layout_width="1dp" android:layout_height="32dp"
                        android:background="#1E3A4A" android:layout_marginStart="10dp" android:layout_marginEnd="10dp"/>
                    <EditText android:id="@+id/etValor"
                        android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                        android:background="@null" android:hint="0"
                        android:textColorHint="#334455" android:inputType="number"
                        android:textSize="18sp" android:textStyle="bold" android:textColor="#EEFFEE"/>
                </LinearLayout>
                <TextView android:id="@+id/tvMonedaBadge"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="🇨🇴 COP" android:textColor="#4CAF50" android:textSize="12sp"
                    android:layout_marginBottom="14dp" android:layout_marginStart="4dp"/>

                <!-- CUENTA -->
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="CUENTA" android:textColor="#4CAF50"
                    android:textSize="10sp" android:letterSpacing="0.15" android:layout_marginBottom="6dp"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="52dp"
                    android:background="@drawable/finanzas_input_bg"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingStart="14dp" android:paddingEnd="14dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="🏦" android:textSize="16sp" android:layout_marginEnd="10dp"/>
                    <Spinner android:id="@+id/spinnerCuenta"
                        android:layout_width="match_parent" android:layout_height="match_parent"
                        android:background="@null" android:popupBackground="#111E2E"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Formulario transferencia -->
            <LinearLayout android:id="@+id/layoutFormularioTransferencia"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/finanzas_card_background"
                android:padding="16dp" android:layout_marginBottom="10dp"
                android:visibility="gone">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="CUENTA ORIGEN" android:textColor="#4CAF50"
                    android:textSize="10sp" android:letterSpacing="0.15" android:layout_marginBottom="6dp"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="52dp"
                    android:background="@drawable/finanzas_input_bg"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingStart="14dp" android:paddingEnd="14dp" android:layout_marginBottom="14dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="⬆️" android:textSize="16sp" android:layout_marginEnd="10dp"/>
                    <Spinner android:id="@+id/spinnerCuentaOrigen"
                        android:layout_width="match_parent" android:layout_height="match_parent"
                        android:background="@null" android:popupBackground="#111E2E"/>
                </LinearLayout>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="CUENTA DESTINO" android:textColor="#4CAF50"
                    android:textSize="10sp" android:letterSpacing="0.15" android:layout_marginBottom="6dp"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="52dp"
                    android:background="@drawable/finanzas_input_bg"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingStart="14dp" android:paddingEnd="14dp" android:layout_marginBottom="14dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="⬇️" android:textSize="16sp" android:layout_marginEnd="10dp"/>
                    <Spinner android:id="@+id/spinnerCuentaDestino"
                        android:layout_width="match_parent" android:layout_height="match_parent"
                        android:background="@null" android:popupBackground="#111E2E"/>
                </LinearLayout>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="DETALLE (opcional)" android:textColor="#4CAF50"
                    android:textSize="10sp" android:letterSpacing="0.15" android:layout_marginBottom="6dp"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="52dp"
                    android:background="@drawable/finanzas_input_bg"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingStart="14dp" android:paddingEnd="14dp" android:layout_marginBottom="14dp">
                    <EditText android:id="@+id/etDetalleTransf"
                        android:layout_width="match_parent" android:layout_height="match_parent"
                        android:background="@null" android:hint="Descripción..."
                        android:textColorHint="#334455" android:textSize="15sp" android:textColor="#EEFFEE"/>
                </LinearLayout>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="VALOR" android:textColor="#4CAF50"
                    android:textSize="10sp" android:letterSpacing="0.15" android:layout_marginBottom="6dp"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="54dp"
                    android:background="@drawable/finanzas_input_bg"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingStart="14dp" android:paddingEnd="14dp">
                    <EditText android:id="@+id/etValorTransf"
                        android:layout_width="match_parent" android:layout_height="match_parent"
                        android:background="@null" android:hint="0"
                        android:textColorHint="#334455" android:inputType="number"
                        android:textSize="18sp" android:textStyle="bold" android:textColor="#EEFFEE"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Botón guardar mejorado -->
            <Button android:id="@+id/btnGuardarMovimiento"
                android:layout_width="match_parent" android:layout_height="56dp"
                android:text="GUARDAR MOVIMIENTO"
                android:textAllCaps="false" android:textColor="#FFFFFF"
                android:textSize="16sp" android:textStyle="bold"
                android:background="@drawable/finanzas_btn_green"
                android:layout_marginTop="4dp"/>

        </LinearLayout>
    </ScrollView>
</LinearLayout>