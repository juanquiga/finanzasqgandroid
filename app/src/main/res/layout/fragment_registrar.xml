<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0A1628">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@drawable/finanzas_card_background"
        android:padding="16dp" android:gravity="center"
        android:layout_marginStart="16dp" android:layout_marginEnd="16dp"
        android:layout_marginTop="16dp" android:layout_marginBottom="8dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="💰 Registrar Movimiento" android:textColor="#4CAF50"
            android:textSize="18sp" android:textStyle="bold" android:gravity="center"/>
    </LinearLayout>

    <!-- Selector tipo — texto más corto para que no se corte -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/finanzas_card_background"
        android:paddingStart="4dp" android:paddingEnd="4dp"
        android:paddingTop="6dp" android:paddingBottom="6dp"
        android:layout_marginStart="16dp" android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp">

        <Button android:id="@+id/btnTipoEgreso"
            android:layout_width="0dp" android:layout_height="44dp"
            android:layout_weight="1"
            android:text="📉 Egreso"
            android:textSize="12sp"
            android:textAllCaps="false"
            android:textColor="#FFFFFF" android:textStyle="bold"
            android:backgroundTint="#FF5252"
            android:layout_marginEnd="2dp"/>

        <Button android:id="@+id/btnTipoIngreso"
            android:layout_width="0dp" android:layout_height="44dp"
            android:layout_weight="1"
            android:text="📈 Ingreso"
            android:textSize="12sp"
            android:textAllCaps="false"
            android:textColor="#4CAF50"
            android:backgroundTint="#0D1A2A"
            android:layout_marginEnd="2dp"/>

        <Button android:id="@+id/btnTipoTransferencia"
            android:layout_width="0dp" android:layout_height="44dp"
            android:layout_weight="1"
            android:text="🔄 Transfer"
            android:textSize="11sp"
            android:textAllCaps="false"
            android:textColor="#2196F3"
            android:backgroundTint="#0D1A2A"/>

    </LinearLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp" android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <!-- Formulario normal -->
            <LinearLayout android:id="@+id/layoutFormularioNormal"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/finanzas_card_background"
                android:padding="16dp" android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="CATEGORÍA" android:textColor="#4CAF50"
                    android:textSize="11sp" android:letterSpacing="0.1"
                    android:layout_marginBottom="6dp"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="50dp"
                    android:background="@drawable/finanzas_input_bg"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingStart="12dp" android:paddingEnd="12dp"
                    android:layout_marginBottom="12dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="🏷" android:textSize="15sp" android:layout_marginEnd="8dp"/>
                    <Spinner android:id="@+id/spinnerCategoria"
                        android:layout_width="match_parent" android:layout_height="match_parent"
                        android:background="@null" android:popupBackground="#111E2E"/>
                </LinearLayout>

                <TextView android:id="@+id/tvLabelSubcat"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="SUBCATEGORÍA" android:textColor="#4CAF50"
                    android:textSize="11sp" android:letterSpacing="0.1"
                    android:layout_marginBottom="6dp"/>
                <LinearLayout android:id="@+id/layoutSubcat"
                    android:layout_width="match_parent" android:layout_height="50dp"
                    android:background="@drawable/finanzas_input_bg"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingStart="12dp" android:paddingEnd="12dp"
                    android:layout_marginBottom="12dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="📂" android:textSize="15sp" android:layout_marginEnd="8dp"/>
                    <Spinner android:id="@+id/spinnerSubcategoria"
                        android:layout_width="match_parent" android:layout_height="match_parent"
                        android:background="@null" android:popupBackground="#111E2E"/>
                </LinearLayout>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="DETALLE (opcional)" android:textColor="#4CAF50"
                    android:textSize="11sp" android:letterSpacing="0.1"
                    android:layout_marginBottom="6dp"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="50dp"
                    android:background="@drawable/finanzas_input_bg"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingStart="12dp" android:paddingEnd="12dp"
                    android:layout_marginBottom="12dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="📄" android:textSize="15sp" android:layout_marginEnd="8dp"/>
                    <EditText android:id="@+id/etDetalle"
                        android:layout_width="match_parent" android:layout_height="match_parent"
                        android:background="@null" android:hint="Ej: Almuerzo, Gasolina..."
                        android:textColorHint="#334455" android:textSize="15sp"
                        android:textColor="#EEFFEE"/>
                </LinearLayout>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="VALOR" android:textColor="#4CAF50"
                    android:textSize="11sp" android:letterSpacing="0.1"
                    android:layout_marginBottom="6dp"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="50dp"
                    android:background="@drawable/finanzas_input_bg"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingStart="12dp" android:paddingEnd="12dp"
                    android:layout_marginBottom="6dp">
                    <Spinner android:id="@+id/spinnerMoneda"
                        android:layout_width="wrap_content" android:layout_height="match_parent"
                        android:background="@null" android:popupBackground="#111E2E"/>
                    <View android:layout_width="1dp" android:layout_height="30dp"
                        android:background="#1E3A4A"
                        android:layout_marginStart="8dp" android:layout_marginEnd="8dp"/>
                    <EditText android:id="@+id/etValor"
                        android:layout_width="0dp" android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@null" android:hint="0"
                        android:textColorHint="#334455" android:inputType="number"
                        android:textSize="16sp" android:textColor="#EEFFEE"/>
                </LinearLayout>

                <TextView android:id="@+id/tvMonedaBadge"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="🇨🇴 COP"
                    android:textColor="#4CAF50" android:textSize="12sp"
                    android:layout_marginBottom="12dp" android:layout_marginStart="4dp"/>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="CUENTA" android:textColor="#4CAF50"
                    android:textSize="11sp" android:letterSpacing="0.1"
                    android:layout_marginBottom="6dp"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="50dp"
                    android:background="@drawable/finanzas_input_bg"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingStart="12dp" android:paddingEnd="12dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="🏦" android:textSize="15sp" android:layout_marginEnd="8dp"/>
                    <Spinner android:id="@+id/spinnerCuenta"
                        android:layout_width="match_parent" android:layout_height="match_parent"
                        android:background="@null" android:popupBackground="#111E2E"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Formulario transferencia -->
            <LinearLayout android:id="@+id/layoutFormularioTransferencia"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/finanzas_card_background"
                android:padding="16dp" android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:visibility="gone">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="CUENTA ORIGEN" android:textColor="#4CAF50"
                    android:textSize="11sp" android:letterSpacing="0.1"
                    android:layout_marginBottom="6dp"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="50dp"
                    android:background="@drawable/finanzas_input_bg"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingStart="12dp" android:paddingEnd="12dp"
                    android:layout_marginBottom="12dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="⬆️" android:textSize="15sp" android:layout_marginEnd="8dp"/>
                    <Spinner android:id="@+id/spinnerCuentaOrigen"
                        android:layout_width="match_parent" android:layout_height="match_parent"
                        android:background="@null" android:popupBackground="#111E2E"/>
                </LinearLayout>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="CUENTA DESTINO" android:textColor="#4CAF50"
                    android:textSize="11sp" android:letterSpacing="0.1"
                    android:layout_marginBottom="6dp"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="50dp"
                    android:background="@drawable/finanzas_input_bg"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingStart="12dp" android:paddingEnd="12dp"
                    android:layout_marginBottom="12dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="⬇️" android:textSize="15sp" android:layout_marginEnd="8dp"/>
                    <Spinner android:id="@+id/spinnerCuentaDestino"
                        android:layout_width="match_parent" android:layout_height="match_parent"
                        android:background="@null" android:popupBackground="#111E2E"/>
                </LinearLayout>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="DETALLE (opcional)" android:textColor="#4CAF50"
                    android:textSize="11sp" android:letterSpacing="0.1"
                    android:layout_marginBottom="6dp"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="50dp"
                    android:background="@drawable/finanzas_input_bg"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingStart="12dp" android:paddingEnd="12dp"
                    android:layout_marginBottom="12dp">
                    <EditText android:id="@+id/etDetalleTransf"
                        android:layout_width="match_parent" android:layout_height="match_parent"
                        android:background="@null" android:hint="Descripción..."
                        android:textColorHint="#334455" android:textSize="15sp"
                        android:textColor="#EEFFEE"/>
                </LinearLayout>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="VALOR" android:textColor="#4CAF50"
                    android:textSize="11sp" android:letterSpacing="0.1"
                    android:layout_marginBottom="6dp"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="50dp"
                    android:background="@drawable/finanzas_input_bg"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingStart="12dp" android:paddingEnd="12dp">
                    <EditText android:id="@+id/etValorTransf"
                        android:layout_width="match_parent" android:layout_height="match_parent"
                        android:background="@null" android:hint="0"
                        android:textColorHint="#334455" android:inputType="number"
                        android:textSize="16sp" android:textColor="#EEFFEE"/>
                </LinearLayout>
            </LinearLayout>

            <Button android:id="@+id/btnGuardarMovimiento"
                android:layout_width="match_parent" android:layout_height="54dp"
                android:text="GUARDAR MOVIMIENTO"
                android:textAllCaps="false"
                android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold"
                android:background="@drawable/finanzas_btn_green"/>

        </LinearLayout>
    </ScrollView>
</LinearLayout>