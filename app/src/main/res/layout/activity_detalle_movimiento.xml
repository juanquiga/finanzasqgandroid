<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0A1628"
    android:padding="20dp">

    <!-- Header -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:gravity="center"
        android:background="@drawable/finanzas_card_background"
        android:padding="24dp" android:layout_marginBottom="16dp">

        <TextView android:id="@+id/tvDetalleTipoEmoji"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="📉" android:textSize="48sp" android:layout_marginBottom="8dp"/>

        <TextView android:id="@+id/tvDetalleTipo"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Egreso" android:textColor="#FF5252"
            android:textSize="22sp" android:textStyle="bold"/>

        <TextView android:id="@+id/tvDetalleValor"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="$0" android:textColor="#FF5252"
            android:textSize="32sp" android:textStyle="bold"
            android:layout_marginTop="8dp"/>

        <TextView android:id="@+id/tvDetalleMoneda"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="COP" android:textColor="#445566"
            android:textSize="14sp" android:layout_marginTop="4dp"/>
    </LinearLayout>

    <!-- Detalles -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/finanzas_card_background"
        android:padding="20dp" android:layout_marginBottom="16dp">

        <!-- Fila -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="14dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="Categoría"
                android:textColor="#445566" android:textSize="14sp"/>
            <TextView android:id="@+id/tvDetalleCategoria"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="-"
                android:textColor="#EEFFEE" android:textSize="14sp"
                android:textStyle="bold" android:gravity="end"/>
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="#1E3A4A" android:layout_marginBottom="14dp"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="14dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="Subcategoría"
                android:textColor="#445566" android:textSize="14sp"/>
            <TextView android:id="@+id/tvDetalleSubcat"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="-"
                android:textColor="#EEFFEE" android:textSize="14sp"
                android:textStyle="bold" android:gravity="end"/>
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="#1E3A4A" android:layout_marginBottom="14dp"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="14dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="Detalle"
                android:textColor="#445566" android:textSize="14sp"/>
            <TextView android:id="@+id/tvDetalleDetalle"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="-"
                android:textColor="#EEFFEE" android:textSize="14sp"
                android:textStyle="bold" android:gravity="end"/>
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="#1E3A4A" android:layout_marginBottom="14dp"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="14dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="Cuenta"
                android:textColor="#445566" android:textSize="14sp"/>
            <TextView android:id="@+id/tvDetalleCuenta"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="-"
                android:textColor="#EEFFEE" android:textSize="14sp"
                android:textStyle="bold" android:gravity="end"/>
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="#1E3A4A" android:layout_marginBottom="14dp"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="Fecha"
                android:textColor="#445566" android:textSize="14sp"/>
            <TextView android:id="@+id/tvDetalleFecha"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="-"
                android:textColor="#EEFFEE" android:textSize="13sp"
                android:gravity="end"/>
        </LinearLayout>
    </LinearLayout>

    <Button android:id="@+id/btnCerrarDetalle"
        android:layout_width="match_parent" android:layout_height="52dp"
        android:text="CERRAR"
        android:textColor="#FFFFFF" android:textStyle="bold"
        android:background="@drawable/finanzas_btn_green"/>

</LinearLayout>